Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Code, data and generated PDFs are never served directly. PDFs open
  # through pdf.php with a signed link.
  RewriteRule ^(config|includes|classes|bot|database|vendor|scripts|templates|pdfs|docs|\.git)(/|$) - [F,L]
</IfModule>

# Dumps, notes, lock files and anything that looks like a credential note
<FilesMatch "(\.(sql|md|lock|phar|log|bak|env)|^composer\.json|^DB_NAME.*|^ADMIN.*\.txt|^\.cpanel\.yml|^\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
